DATABASE_URL="file:./prisma/dev.db"
# Telefonla QR demo: makinenin LAN IP'si kullanilir (npm run lan-ip ile ogren);
# localhost kalirsa telefon QR okutunca kendi localhost'una gider (demo kirilir)
APP_URL="http://localhost:3000"
MUNICIPALITY_NAME="Örnek Belediyesi"
UPLOAD_DIR="./public/uploads"
# Oturum imzalama anahtarı. Min. 32 karakter; `openssl rand -base64 32` ile üretin.
SESSION_SECRET="değiştirin-uzun-rastgele-dize-32-karakter-minimum"
